# ── Telegram API (read by config.py as API_ID / API_HASH) ──
# Note: the names are API_ID / API_HASH, not TELEGRAM_API_ID / TELEGRAM_API_HASH.
API_ID=your_api_id_here
API_HASH=your_api_hash_here
TELEGRAM_SESSION_NAME=pubg_scraper_session

# ── Monetization / bot ──────────────────────────────────────
# Bot token from @BotFather — used by the bot AND by background jobs
# (renewal reminders, daily digest) via the Bot API.
BOT_TOKEN=your_bot_token_here
# Your own Telegram chat id — receives admin alerts, payment review cards,
# and the daily digest.
MY_CHAT_ID=your_chat_id_here

# Manual payment collection (shown to buyers in /pay)
VODAFONE_CASH_NUMBER=01xxxxxxxxx
INSTAPAY_HANDLE=your@instapay

# ── Scraper tuning ──────────────────────────────────────────
MIN_PROFIT_THRESHOLD=300
TARGET_CHATS=

# ── Ops ─────────────────────────────────────────────────────
# Internal token for bot -> API deal push authentication.
INTERNAL_TOKEN=
# Scheduler cadence in minutes (default 360). The lifecycle job still runs
# at most once per UTC day regardless of this value.
SCHEDULER_INTERVAL_MINUTES=360

# ── CORS (comma-separated origins, or * for dev) ───────────
ALLOWED_ORIGINS=http://localhost:8000

# ── AWS / S3 (Block 4) ─────────────────────────────────────
# On EC2 the LabInstanceProfile provides credentials automatically.
# Locally, put temporary lab credentials in .env (never commit).
S3_BUCKET=
AWS_REGION=us-east-1
