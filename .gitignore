# ── Secrets & sessions (NEVER commit) ────────────────────────
.env
*.session
*.session-journal

# ── Python runtime ───────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Data & model artifacts (regenerable / large) ─────────────
data/
logs/
db/*.db
catboost_info/
mlruns/

# ── OS junk ──────────────────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── SSH keys (never commit) ─────────────────────────────────
*.pem
